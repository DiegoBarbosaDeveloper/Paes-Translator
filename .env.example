# Ambiente de ejecucion: dev | test | prod
APP_ENV=dev

# Seguridad de Flask (genera un valor fuerte en produccion)
SECRET_KEY=replace-with-a-strong-secret

# Conexion principal a PostgreSQL (Supabase o local). Usa el driver psycopg v3.
DATABASE_URL=postgresql+psycopg://admin:admin123@localhost:5432/postgres

# Conexion usada durante pruebas automatizadas
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# Rutas opcionales del modelo NLLB (solo si se instalan deps de IA)
# NLLB_ADAPTER_DIR=NLLBTest1/models/nllb-spa-piapoco-achagua
# NLLB_BASE_MODEL_PATH=models/nllb-200-distilled-600M
# NLLB_BASE_MODEL_ID=facebook/nllb-200-distilled-600M
